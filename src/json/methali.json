        "text": "Tunda jema, halikawii mtini",
        "category": "T"
    },
    {
        "id": 249,
        "text": "Uchungu wa mwana, aujuaye mzazi",
        "category": "U"
    },
    {
        "id": 250,
        "text": "Udugu wa nazi, hukutana chunguni",
        "category": "U"
    },
    {
        "id": 251,
        "text": "Ukilima “pantosha”, utavuna “pankwisha”",
        "category": "U"
    },
    {
        "id": 252,
        "text": "Ukiona vyaelea, vimeundwa",
        "category": "U"
    },
    {
        "id": 253,
        "text": "Ukistaajabu ya Musa, utaona ya firauni",
        "category": "U"
    },
    {
        "id": 254,
        "text": "Ukitaka kumla nguruwe, chagua aliye nona",
        "category": "U"
    },
    {
        "id": 255,
        "text": "Ukubwa ni, jalala",
        "category": "U"
    },
    {
        "id": 256,
        "text": "Ulimi, hauna mfupa",
        "category": "U"
    },
    {
        "id": 257,
        "text": "Usitupe jongoo, na mti wake",
        "category": "U"
    },
    {
        "id": 258,
        "text": "Ushikwapo, shikamana",
        "category": "U"
    },
    {
        "id": 259,
        "text": "Usiache mbachao, kwa msala upitao",
        "category": "U"
    },
    {
        "id": 260,
        "text": "Usipoziba ufa, utajenga ukuta",
        "category": "U"
    },
    {
        "id": 261,
        "text": "Usimwamshe aliyelala, ukimwamsha utalala wewe",
        "category": "U"
    },
    {
        "id": 262,
        "text": "Usitukane wakunga, na uzazi ungalipo",
        "category": "U"
    },
    {
        "id": 263,
        "text": "Uzuri wa mkakasi, ndani kipande cha mti",
        "category": "U"
    },
    {
        "id": 264,
        "text": "Ukitaka kuruka, Agana na nyonga",
        "category": "U"
    },
    {
        "id": 265,
        "text": "Ukienda kwa mwenye chongo, fumba lako jicho.",
        "category": "U"
    },
    {
        "id": 266,
        "text": "Ukipenda boga, penda na ua lake.",
        "category": "U"
    },
    {
        "id": 267,
        "text": "Ukitaka kuwa mvuvi, sharti ujue kuogelea.",
        "category": "U"
    },
    {
        "id": 268,
        "text": "Ukitaka uzuri, sharti udhurike.",
        "category": "U"
    },
    {
        "id": 269,
        "text": "Umekula ng’ombe mzima, washindwa mkia?",
        "category": "U"
    },
    {
        "id": 270,
        "text": "Undugu ni kufaana, sio kufanana.",
        "category": "U"
    },
    {
        "id": 271,
        "text": "Uongo wa mwenye nyumba si ukweli wa mpita njia.",
        "category": "U"
    },
    {
        "id": 272,
        "text": "Upele humwota, asiye na kucha.",
        "category": "U"
    },
    {
        "id": 273,
        "text": "Usiandikie mate, na wino ungalipo.",
        "category": "U"
    },
    {
        "id": 274,
        "text": "Usigombane na mkwezi, nazi imeliwa na mwezi",
        "category": "U"
    },
    {
        "id": 275,
        "text": "Ukila na kipofu usimguse mkono.",
        "category": "U"
    },
    {
        "id": 276,
        "text": "Usisafirie nyota ya mwenzio",
        "category": "U"
    },
    {
