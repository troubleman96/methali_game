        "text": "Mchoyo, hana rafiki.",
        "category": "M"
    },
    {
        "id": 182,
        "text": "Mficha maradhi, mauti/kifo humuumbua",
        "category": "M"
    },
    {
        "id": 183,
        "text": "Mganga, hajigangi",
        "category": "M"
    },
    {
        "id": 184,
        "text": "Mgema akisifiwa, tembo hulitia maji.",
        "category": "M"
    },
    {
        "id": 185,
        "text": "Mkaidi hafaidi, hadi siku ya iddi.",
        "category": "M"
    },
    {
        "id": 186,
        "text": "Mkuki kwa nguruwe, kwa binadamu mchungu.",
        "category": "M"
    },
    {
        "id": 187,
        "text": "Mchele mmoja, mapishi mbalimbali.",
        "category": "M"
    },
    {
        "id": 188,
        "text": "Mpanda ngazi, hushuka.",
        "category": "M"
    },
    {
        "id": 189,
        "text": "Mpanda hovyo, hula ovyo.",
        "category": "M"
    },
    {
        "id": 190,
        "text": "Mpenda chongo, huona kengeza.",
        "category": "M"
    },
    {
        "id": 191,
        "text": "Msafiri, kafiri.",
        "category": "M"
    },
    {
        "id": 192,
        "text": "Mshika mawili, moja humponyoka.",
        "category": "M"
    },
    {
        "id": 193,
        "text": "Maskini haokoti, akiokota huambiwa ameiba.",
        "category": "M"
    },
    {
        "id": 194,
        "text": "Mtegemea cha nduguye, hufa maskini",
        "category": "M"
    },
    {
        "id": 195,
        "text": "Mwana wa kuku, hafunzwi kuchakura.",
        "category": "M"
    },
    {
        "id": 196,
        "text": "Mwanzo wa ngoma, ni lele",
        "category": "M"
    },
    {
        "id": 197,
        "text": "Mwenye shibe, hamjui mwenye njaa",
        "category": "M"
    },
    {
        "id": 198,
        "text": "Ngoja ngoja, yaumiza matumbo",
        "category": "N"
    },
    {
        "id": 199,
        "text": "Nazi mbovu, haramu ya nzima",
        "category": "N"
    },
    {
        "id": 200,
        "text": "Ndugu mui, afadhali kuwa naye",
        "category": "N"
    },
    {
        "id": 201,
        "text": "Nahodha wengi, chombo huenda mrama",
        "category": "N"
    },
    {
        "id": 202,
        "text": "Ng’ombe wa masikini, hazai",
        "category": "N"
    },
    {
        "id": 203,
        "text": "Njia ya mwongo, ni fupi",
        "category": "N"
    },
    {
        "id": 204,
        "text": "Ndege mjanja, hunaswa na tundu bovu",
        "category": "N"
    },
    {
        "id": 205,
        "text": "Ng’ombe, halemewi na nunduye.",
        "category": "N"
    },
    {
        "id": 206,
        "text": "Nifae kwa mvua, nikufae kwa jua.",
        "category": "N"
    },
    {
        "id": 207,
        "text": "Nyota njema, huonekana asubuhi.",
        "category": "N"
    },
    {
        "id": 208,
        "text": "Nyumba ya udongo, haistahimili vishindo",
        "category": "N"
    },
    {
        "id": 209,
        "text": "Ogopa, ni ngao pia",
        "category": "O"
    },
    {
        "id": 210,
        "text": "Ondoa dari, uezeke paa",
        "category": "O"
    },
    {
        "id": 211,
        "text": "Pabaya pako, si pema pa mwenzio",
        "category": "P"
    },
    {
        "id": 212,
        "text": "Paka akiondoka, panya hutawala",
        "category": "P"
    },
    {
        "id": 213,
        "text": "Pang’okapo jino, pana pengo",
        "category": "P"
    },
    {
        "id": 214,
        "text": "Pema usijapo pema, ukipema si pema tena",
        "category": "P"
    },
    {
        "id": 215,
        "text": "Penye kuku wengi, usimwage mtama",
        "category": "P"
    },
    {
        "id": 216,
        "text": "Penye nia, pana njia",
        "category": "P"
    },
    {
        "id": 217,
        "text": "Penye wazee, hapaharibiki neno",
        "category": "P"
    },
    {
        "id": 218,
        "text": "Pilipili usiyoila, yakuwashia nini?",
        "category": "P"
    },
    {
        "id": 219,
        "text": "Penye urembo, ndipo penye urimbo",
        "category": "P"
    },
    {
        "id": 220,
        "text": "Pole pole, ndio mwendo",
        "category": "P"
    },
    {
        "id": 221,
        "text": "Paka akiwa hakimu, panya hawezi kushinda kesi.",
        "category": "P"
    },
    {
        "id": 222,
        "text": "Paka hawekewi, kitoweo kulinda",
        "category": "P"
    },
    {
        "id": 223,
        "text": "Pwagu, hupata pwaguzi",
        "category": "P"
    },
    {
        "id": 224,
        "text": "Radhi ni bora, kuliko mali",
        "category": "R"
    },
    {
        "id": 225,
        "text": "Raha, haina karaha",
        "category": "R"
    },
    {
        "id": 226,
        "text": "Safari ni, hatua",
        "category": "S"
    },
    {
        "id": 227,
        "text": "Samaki mkunje, angali mbichi",
        "category": "S"
    },
    {
        "id": 228,
        "text": "Samaki mmoja akioza, wote wameoza",
        "category": "S"
    },
    {
        "id": 229,
        "text": "Sheria ni msumeno, hukata huku na huku",
        "category": "S"
    },
    {
        "id": 230,
        "text": "Sikio, halilali njaa",
        "category": "S"
    },
    {
        "id": 231,
        "text": "Sikio la kufa, halisikii dawa",
        "category": "S"
    },
    {
        "id": 232,
        "text": "Siku njema, huonekana asubuhi",
        "category": "S"
    },
    {
        "id": 233,
        "text": "Simba mwenda pole, ndiye mla nyama",
        "category": "S"
    },
    {
        "id": 234,
        "text": "Siri ya mtungi, aijuaye kata",
        "category": "S"
    },
    {
        "id": 235,
        "text": "Sisimizi, hawi ng’ombe",
        "category": "S"
    },
    {
        "id": 236,
        "text": "Shibe mwana malevya, njaa mwana malegeza,",
        "category": "S"
    },
    {
        "id": 237,
        "text": "Shoka lisilo na mpini, halichanji kuni.",
        "category": "S"
    },
    {
        "id": 238,
        "text": "Shukrani ya punda, ni mateke",
        "category": "S"
    },
    {
        "id": 239,
        "text": "Siku za mwizi, ni arobaini.",
        "category": "S"
    },
    {
        "id": 240,
        "text": "Simba hamli, mwanawe.",
        "category": "S"
    },
    {
        "id": 241,
        "text": "Sipandi punda, asiye na matandiko.",
        "category": "S"
    },
    {
        "id": 242,
        "text": "Subira, yavuta heri",
        "category": "S"
    },
    {
        "id": 243,
        "text": "Tahadhari, kabla ya shari",
        "category": "T"
    },
    {
        "id": 244,
        "text": "Tajiri na mali yake, maskini na mwanawe",
        "category": "T"
    },
    {
        "id": 245,
        "text": "Tamaa mbele, mauti nyuma",
